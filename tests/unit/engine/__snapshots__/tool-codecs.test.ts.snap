        "name": "read_file",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
            },
          },
          "required": [
            "path",
          ],
          "type": "object",
        },
      },
      "type": "function",
    },
  ],
}
`;

